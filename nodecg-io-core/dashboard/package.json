        "url": "https://github.com/codeoverflow-org/nodecg-io.git",
        "directory": "nodecg-io-core/dashboard"
    },
    "license": "MIT",
    "scripts": {
        "build": "vue-cli-service build",
        "lint": "vue-cli-service lint",
        "watch": "vue-cli-service build --watch"
    },
    "dependencies": {
        "@mdi/font": "5.9.55",
        "core-js": "^3.6.5",
        "monaco-editor": "^0.30.0",
        "nodecg-io-core": "^0.2.0",
        "roboto-fontface": "*",
        "vue": "^3.0.0",
        "vuetify": "^3.0.0-alpha.12",
        "webfontloader": "^1.0.0"
    },
    "devDependencies": {
        "@types/webfontloader": "^1.0.0",
        "@typescript-eslint/eslint-plugin": "^5.3.1",
        "@typescript-eslint/parser": "^5.2.0",
        "@vue/cli-plugin-babel": "^5.0.0-rc.0",
        "@vue/cli-plugin-eslint": "^5.0.0-rc.0",
        "@vue/cli-plugin-typescript": "^5.0.0-rc.0",
        "@vue/cli-service": "^5.0.0-rc.0",
        "@vue/compiler-sfc": "^3.2.22",
        "@vue/eslint-config-prettier": "^6.0.0",
        "@vue/eslint-config-typescript": "^9.0.0",
        "eslint": "^8.2.0",
        "eslint-plugin-prettier": "^3.3.1",
        "eslint-plugin-vue": "^8.0.0",
        "lint-staged": "^9.5.0",
        "monaco-editor-webpack-plugin": "^6.0.0",
        "nodecg-types": "^1.8.2",
        "prettier": "^2.2.1",
        "sass": "^1.38.0",
